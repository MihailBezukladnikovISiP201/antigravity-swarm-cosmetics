{
  "swarm-cosmetics-autoseed": {
    "SessionStart": [
      {
        "command": "node scripts/patch.js apply"
      }
    ],
    "PreInvocation": [
      {
        "command": "node scripts/patch.js apply"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "swarm.*",
        "hooks": [
          {
            "command": "node scripts/patch.js apply"
          }
        ]
      }
    ]
  }
}
